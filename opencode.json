{
  "$schema": "https://opencode.ai",
  "name": "drives-system",
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    }
  },
  "mcp": {
    "local-postgres": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "args": ["postgresql://test:test@localhost:5432/database_name"]
    }
  }
}
