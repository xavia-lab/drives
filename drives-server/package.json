{
  "name": "@drives/drives-server",
  "version": "0.0.6",
  "description": "A Nest.JS based API backend!",
  "author": "Rehan Mahmood",
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "build:image": "task build-server",
    "start": "nest start",
    "dev": "pnpm start:dev",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --watch=false",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migration:generate": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize migration:generate --name",
    "migration:run": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "migration:undo": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "migration:undo:all": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "seed:generate": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize seed:generate --name",
    "seed:run": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "exchange-rate:sync": "ts-node -r tsconfig-paths/register scripts/sync-exchange-rates.ts",
    "seed:undo": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:seed:undo",
    "seed:undo:all": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:seed:undo:all",
    "seed:test": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:seed:all --seeders-path src/database/test-seeders",
    "seed:test:undo": "node --env-file=.env ./node_modules/sequelize-cli/lib/sequelize db:seed:undo --seeders-path src/database/test-seeders --seed $(basename -a src/database/test-seeders/*.js)",
    "seed:test:teardown": "node --env-file=.env scripts/teardown-test-data.js",
    "seed:test:reset": "pnpm seed:test:teardown && pnpm seed:run && pnpm seed:test",
    "db:sync": "ts-node -r tsconfig-paths/register scripts/sync-database.ts",
    "db:sync:force": "ts-node -r tsconfig-paths/register scripts/sync-database.ts --force",
    "db:sync:alter": "ts-node -r tsconfig-paths/register scripts/sync-database.ts --alter",
    "db:setup": "pnpm migration:run && pnpm seed:run",
    "db:setup:test": "pnpm migration:run && pnpm seed:run && pnpm seed:test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@cerbos/grpc": "^0.29.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/sequelize": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "collect.js": "^4.36.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.35.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@cerbos/core": "^0.33.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.15.43",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/ui": "^5.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.1.4",
    "vitest": "^5.0.4"
  }
}
